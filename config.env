# OBD Bridge defaults — edit before sudo ./install.sh if desired.
# Installed copy lives at /etc/obd-bridge/config.env

AP_SSID=crosstrek-obd
AP_PASS=obdbridge1
AP_IP=192.168.4.1
AP_CIDR=24
AP_DHCP_START=192.168.4.50
AP_DHCP_END=192.168.4.150
AP_IFACE=wlan0

ELM_TCP_PORT=35000
RFCOMM_DEV=/dev/rfcomm0
RFCOMM_CHANNEL=1

BT_PIN=1234
BT_NAME_REGEX='OBDII|ELM327|V-LINK|BAFX|OBD'
# Optional: skip discovery and use a known adapter MAC
# BT_MAC=AA:BB:CC:DD:EE:FF

BT_SCAN_SECONDS=20
RFCOMM_RETRY_SECONDS=5
PROXY_WAIT_SECONDS=2
