# OBD Bridge defaults — edit before sudo ./install.sh if desired.
# Installed copy lives at /etc/obd-bridge/config.env

# Wi-Fi AP for phone apps. On Pi 3 the AP shares the radio with Bluetooth and
# breaks classic ELM discovery — leave 0 if you use ethernet + PiTFT only.
ENABLE_AP=0

AP_SSID=obd-bridge
AP_PASS=obdbridge1
AP_IP=192.168.4.1
AP_CIDR=24
AP_DHCP_START=192.168.4.50
AP_DHCP_END=192.168.4.150
AP_IFACE=wlan0

ELM_TCP_PORT=35000
RFCOMM_DEV=/dev/rfcomm0
RFCOMM_CHANNEL=1

BT_PIN=1234
BT_NAME_REGEX='OBDII|ELM327|V-LINK|BAFX|OBD'
# Optional: skip discovery and use a known adapter MAC
# BT_MAC=AA:BB:CC:DD:EE:FF

# Classic BR/EDR inquiry for Android-only OBDII (longer helps)
BT_SCAN_SECONDS=30
RFCOMM_RETRY_SECONDS=5
PROXY_WAIT_SECONDS=2
AUTOPAIR_RETRY_SECONDS=15
AUTOPAIR_IDLE_SECONDS=60

# Adafruit PiTFT 2.8" resistive (auto-detects fb0/fb1; override only if needed)
ENABLE_PITFT=1
# TFT_FB=/dev/fb1
# Live temp poller on RFCOMM (shown on PiTFT; also serves TCP :35000)
ENABLE_LIVE_TEMPS=1
LIVE_POLL_SECONDS=1.0
LIVE_ENABLE_TCP=1
