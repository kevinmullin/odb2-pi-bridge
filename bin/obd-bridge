#!/usr/bin/env bash
# obd-bridge — operator CLI (status, doctor, pair)
set -euo pipefail

LIB_DIR="/usr/local/lib/obd-bridge"
if [[ ! -f "${LIB_DIR}/lib.sh" ]]; then
  # Running from a git checkout before install
  ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
  LIB_DIR="${ROOT}/scripts"
  export REPO_ROOT="${ROOT}"
  export OBD_BRIDGE_ETC="${OBD_BRIDGE_ETC:-${ROOT}/.local-etc}"
  mkdir -p "${OBD_BRIDGE_ETC}"
fi

# shellcheck source=/dev/null
source "${LIB_DIR}/lib.sh"
load_config

usage() {
  cat <<EOF
Usage: obd-bridge <command>

  status      Show AP / Bluetooth / RFCOMM / TCP listen state
  doctor      Actionable checks for common failures
  pair        Discover/pair/trust BAFX (requires sudo, adapter powered)
  bt-seen     Show last Bluetooth scan dump (MACs seen while out)
  mock-live   Fake temps for PiTFT desk test (stops live service)
  mock-stop   Stop mock and restart real live polling
  help        Show this help

mock-live options (after command):
  --scenario normal|overheat|waiting   (default: normal)
  --once                               Write one snapshot and exit
EOF
}

cmd_status() {
  echo "=== OBD Bridge status ==="
  echo "config: ${CONFIG_ENV:-?}"
  echo "SSID:   ${AP_SSID}"
  echo "AP IP:  ${AP_IP}"
  echo "TCP:    ${ELM_TCP_PORT}"
  echo "MAC:    ${BT_MAC:-unset}"
  echo

  if ip -4 addr show "${AP_IFACE}" 2>/dev/null | grep -q "${AP_IP}"; then
    echo "AP iface ${AP_IFACE}: UP (${AP_IP})"
  else
    echo "AP iface ${AP_IFACE}: MISSING ${AP_IP}"
  fi

  if systemctl is-active --quiet hostapd 2>/dev/null; then
    echo "hostapd: active"
  else
    echo "hostapd: inactive"
  fi

  if systemctl is-active --quiet dnsmasq 2>/dev/null; then
    echo "dnsmasq: active"
  else
    echo "dnsmasq: inactive"
  fi

  if bt_adapter_ready; then
    echo "bluetooth: adapter ready"
  else
    echo "bluetooth: not ready"
  fi

  if [[ -e "${RFCOMM_DEV}" ]]; then
    echo "rfcomm: ${RFCOMM_DEV} present"
  else
    echo "rfcomm: ${RFCOMM_DEV} missing"
  fi

  if systemctl is-active --quiet obd-bridge-rfcomm 2>/dev/null; then
    echo "obd-bridge-rfcomm: active"
  else
    echo "obd-bridge-rfcomm: inactive"
  fi

  if systemctl is-active --quiet obd-bridge-proxy 2>/dev/null; then
    echo "obd-bridge-proxy: active"
  else
    echo "obd-bridge-proxy: inactive"
  fi

  if ss -lnt 2>/dev/null | grep -q ":${ELM_TCP_PORT} "; then
    echo "tcp :${ELM_TCP_PORT}: listening"
  else
    echo "tcp :${ELM_TCP_PORT}: not listening"
  fi
}

cmd_doctor() {
  local rc=0
  echo "=== OBD Bridge doctor ==="

  if [[ ! -f /etc/obd-bridge/config.env ]]; then
    echo "FAIL: not installed — run sudo ./install.sh from the repo"
    return 1
  fi

  if [[ "${ENABLE_AP:-0}" == "0" ]]; then
    echo "OK: Wi-Fi AP disabled (ENABLE_AP=0) — ethernet/TFT mode"
  elif ! ip -4 addr show "${AP_IFACE}" 2>/dev/null | grep -q "${AP_IP}"; then
    echo "FAIL: ${AP_IFACE} lacks ${AP_IP} — check hostapd / systemd-networkd"
    rc=1
  else
    echo "OK: AP address ${AP_IP} on ${AP_IFACE}"
  fi

  if [[ "${ENABLE_AP:-0}" == "0" ]]; then
    if systemctl is-active --quiet hostapd 2>/dev/null; then
      echo "WARN: hostapd still active — run install again or: sudo systemctl disable --now hostapd"
    else
      echo "OK: hostapd stopped (good for classic BT on Pi 3)"
    fi
  elif ! systemctl is-active --quiet hostapd 2>/dev/null; then
    echo "FAIL: hostapd not active — set Wi-Fi country (sudo raspi-config) and journalctl -u hostapd"
    rc=1
  else
    echo "OK: hostapd active"
  fi

  if [[ "${ENABLE_AP:-0}" == "0" ]]; then
    echo "OK: dnsmasq not required (AP off)"
  elif ! systemctl is-active --quiet dnsmasq 2>/dev/null; then
    echo "WARN: dnsmasq not active — DHCP for phones may fail"
    rc=1
  else
    echo "OK: dnsmasq active"
  fi

  if ! bt_adapter_ready; then
    echo "FAIL: Bluetooth adapter not ready"
    rc=1
  else
    echo "OK: Bluetooth adapter ready"
  fi

  if [[ -z "${BT_MAC:-}" ]]; then
    echo "FAIL: no BT_MAC — power BAFX and run: sudo obd-bridge pair"
    rc=1
  else
    echo "OK: BT_MAC=${BT_MAC}"
  fi

  if [[ ! -e "${RFCOMM_DEV}" ]]; then
    echo "WARN: ${RFCOMM_DEV} missing — normal if ignition is OFF; otherwise check rfcomm service"
  else
    echo "OK: ${RFCOMM_DEV} present"
  fi

  if ! ss -lnt 2>/dev/null | grep -q ":${ELM_TCP_PORT} "; then
    echo "WARN: not listening on :${ELM_TCP_PORT} — proxy waits for RFCOMM"
  else
    echo "OK: listening on :${ELM_TCP_PORT}"
  fi

  if [[ "${rc}" -eq 0 ]]; then
    echo "Doctor: no hard failures."
  else
    echo "Doctor: fix FAIL items above."
  fi
  return "${rc}"
}

cmd_pair() {
  if [[ "${EUID}" -ne 0 ]]; then
    err "pair requires root: sudo obd-bridge pair"
    exit 1
  fi
  local pair_script="${LIB_DIR}/pair-bafx.sh"
  if [[ ! -x "${pair_script}" ]]; then
    err "pair script missing at ${pair_script}"
    exit 1
  fi
  "${pair_script}"
  systemctl restart obd-bridge-rfcomm.service 2>/dev/null || true
  systemctl restart obd-bridge-proxy.service 2>/dev/null || true
  systemctl restart obd-bridge-live.service 2>/dev/null || true
  cmd_status
}

cmd_mock_live() {
  if [[ "${EUID}" -ne 0 ]]; then
    err "mock-live requires root: sudo obd-bridge mock-live"
    exit 1
  fi
  local mock="${LIB_DIR}/mock_live.py"
  if [[ ! -f "${mock}" ]]; then
    err "mock_live.py missing at ${mock} — re-run sudo ./install.sh"
    exit 1
  fi
  systemctl stop obd-bridge-live.service 2>/dev/null || true
  echo "Stopped obd-bridge-live (so mock is not overwritten)."
  echo "PiTFT should update within ~1s. Ctrl-C when done, then: sudo obd-bridge mock-stop"
  exec /usr/bin/python3 "${mock}" "$@"
}

cmd_mock_stop() {
  if [[ "${EUID}" -ne 0 ]]; then
    err "mock-stop requires root: sudo obd-bridge mock-stop"
    exit 1
  fi
  pkill -f '/usr/local/lib/obd-bridge/mock_live.py' 2>/dev/null || true
  pkill -f 'scripts/mock_live.py' 2>/dev/null || true
  systemctl start obd-bridge-live.service 2>/dev/null || true
  echo "Mock stopped; obd-bridge-live started."
}

cmd_bt_seen() {
  local latest="/var/lib/obd-bridge/bt-last-scan.txt"
  local hist="/var/lib/obd-bridge/bt-scan.log"
  if [[ ! -f "${latest}" ]]; then
    echo "No scan dump yet at ${latest}"
    echo "Autopair writes this after each BT scan (survives reboot)."
    return 1
  fi
  echo "=== ${latest} ==="
  cat "${latest}"
  if [[ "${1:-}" == "--history" || "${1:-}" == "-a" ]]; then
    echo
    echo "=== ${hist} (last 80 lines) ==="
    tail -80 "${hist}" 2>/dev/null || true
  else
    echo
    echo "(full history: obd-bridge bt-seen --history  or  less ${hist})"
  fi
}

main() {
  local cmd="${1:-help}"
  shift || true
  case "${cmd}" in
    status) cmd_status ;;
    doctor) cmd_doctor ;;
    pair) cmd_pair ;;
    bt-seen) cmd_bt_seen "$@" ;;
    mock-live) cmd_mock_live "$@" ;;
    mock-stop) cmd_mock_stop ;;
    help|--help|-h) usage ;;
    *)
      usage
      exit 1
      ;;
  esac
}

main "$@"
